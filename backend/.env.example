# Copy to backend/.env for local development. Never commit real secrets.
MPI_ENV=development
MPI_DATABASE_URL=postgresql+psycopg://mpi:mpi@localhost:5432/mpi
MPI_REDIS_URL=redis://localhost:6379/0
MPI_JWT_SECRET=change-me-to-a-long-random-string
MPI_CURSOR_SECRET=change-me-too
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MPI_SECRETS_ENCRYPTION_KEY=
MPI_PUBLIC_WEB_URL=http://localhost:3000
MPI_PUBLIC_API_URL=http://localhost:8000
MPI_ENABLE_DEMO_CONNECTOR=true

# eBay developer application (https://developer.ebay.com/my/keys)
MPI_EBAY_CLIENT_ID=
MPI_EBAY_CLIENT_SECRET=
MPI_EBAY_RU_NAME=
MPI_EBAY_ENVIRONMENT=production

# Amazon Selling Partner API application
MPI_AMAZON_LWA_CLIENT_ID=
MPI_AMAZON_LWA_CLIENT_SECRET=
MPI_AMAZON_SPAPI_APP_ID=
MPI_AMAZON_RESEARCH_REFRESH_TOKEN=
